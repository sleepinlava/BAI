# ── ABI rnaseq_expression Docker image ───────────────────────────────────
# Build:  docker build -f docker/Dockerfile.rnaseq -t abi-rnaseq .
# Run:    docker run --rm -v $(pwd):/data abi-rnaseq plan --type rnaseq_expression ...

FROM condaforge/miniforge3:latest AS base

# ── Mirror configuration for China ──────────────────────────────────────
COPY docker/.condarc /root/.condarc
ARG PIP_INDEX_URL=
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

RUN apt-get update && \
    apt-get install -y --no-install-recommends fonts-wqy-zenhei && \
    rm -rf /var/lib/apt/lists/*

RUN conda install -y -n base -c conda-forge mamba && \
    mamba clean -afy

# ── rnaseq conda environment ─────────────────────────────────────────────
COPY envs/rnaseq.yml /tmp/envs/rnaseq.yml
RUN mamba env create -f /tmp/envs/rnaseq.yml && \
    mamba clean -afy && \
    rm /tmp/envs/rnaseq.yml

# ── Install DESeq2 + clusterProfiler via BiocManager ─────────────────────
COPY scripts/install_deseq2.R /tmp/install_deseq2.R
RUN /opt/conda/envs/rnaseq/bin/Rscript /tmp/install_deseq2.R && \
    rm /tmp/install_deseq2.R

# ── ABI package ──────────────────────────────────────────────────────────
COPY pyproject.toml README.md /app/
COPY environments.yaml /app/
COPY src/ /app/src/
COPY config/ /app/config/
COPY scripts/ /app/scripts/
COPY data/ /app/data/
COPY envs/ /app/envs/
COPY examples/ /app/examples/
COPY golden_traces/ /app/golden_traces/
COPY integrations/ /app/integrations/

# WP11B: the core wheel is plugin-free; build the official plugin
# distributions from the same source tree and install the full combo.
RUN /opt/conda/envs/rnaseq/bin/pip install --no-cache-dir /app/ && \
    /opt/conda/envs/rnaseq/bin/python /app/scripts/build_plugin_wheels.py --outdir /tmp/plugin-dist --build && \
    /opt/conda/envs/rnaseq/bin/pip install --no-cache-dir --no-index --find-links /tmp/plugin-dist \
        abi-agent-plugin-amplicon-16s \
        abi-agent-plugin-easymetagenome \
        abi-agent-plugin-metagenomic-plasmid \
        abi-agent-plugin-metatranscriptomics \
        abi-agent-plugin-rnaseq-expression \
        abi-agent-plugin-viral-viwrap \
        abi-agent-plugin-wgs-bacteria \
        abi-agent-plugin-wgs-bacannot && \
    rm -rf /app/src /app/config /app/pyproject.toml /app/environments.yaml \
    /app/data /app/envs /app/examples /app/golden_traces /app/integrations

# ── Runtime ──────────────────────────────────────────────────────────────
ENV PATH="/opt/conda/envs/rnaseq/bin:$PATH"
ENV ABI_ENV=rnaseq

WORKDIR /data
ENTRYPOINT ["abi"]
CMD ["list-types"]
