# ── ABI amplicon_16s Docker image ────────────────────────────────────────
# Build:  docker build -f docker/Dockerfile.amplicon -t abi-amplicon .
# Run:    docker run --rm -v $(pwd):/data abi-amplicon plan --type amplicon_16s ...

FROM condaforge/miniforge3:latest AS base

# ── Mirror configuration for China ──────────────────────────────────────
COPY docker/.condarc /root/.condarc
ARG PIP_INDEX_URL=
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

RUN apt-get update && \
    apt-get install -y --no-install-recommends fonts-wqy-zenhei && \
    rm -rf /var/lib/apt/lists/*

# Install mamba for faster solves
RUN conda install -y -n base -c conda-forge mamba && \
    mamba clean -afy

# ── amplicon conda environment ───────────────────────────────────────────
COPY envs/amplicon.yml /tmp/envs/amplicon.yml
RUN mamba env create -f /tmp/envs/amplicon.yml && \
    mamba clean -afy && \
    rm /tmp/envs/amplicon.yml

# ── ABI package ──────────────────────────────────────────────────────────
COPY pyproject.toml README.md /app/
COPY environments.yaml /app/
COPY src/ /app/src/
COPY config/ /app/config/
COPY scripts/ /app/scripts/
COPY data/ /app/data/
COPY envs/ /app/envs/
COPY examples/ /app/examples/
COPY golden_traces/ /app/golden_traces/
COPY integrations/ /app/integrations/

# WP11B: the core wheel is plugin-free; build the official plugin
# distributions from the same source tree and install the full combo.
RUN /opt/conda/envs/amplicon/bin/pip install --no-cache-dir /app/ && \
    /opt/conda/envs/amplicon/bin/python /app/scripts/build_plugin_wheels.py --outdir /tmp/plugin-dist --build && \
    /opt/conda/envs/amplicon/bin/pip install --no-cache-dir --no-index --find-links /tmp/plugin-dist \
        abi-agent-plugin-amplicon-16s \
        abi-agent-plugin-easymetagenome \
        abi-agent-plugin-metagenomic-plasmid \
        abi-agent-plugin-metatranscriptomics \
        abi-agent-plugin-rnaseq-expression \
        abi-agent-plugin-viral-viwrap \
        abi-agent-plugin-wgs-bacteria \
        abi-agent-plugin-wgs-bacannot && \
    rm -rf /app/src /app/config /app/pyproject.toml /app/environments.yaml \
    /app/data /app/envs /app/examples /app/golden_traces /app/integrations

# ── Runtime ──────────────────────────────────────────────────────────────
ENV PATH="/opt/conda/envs/amplicon/bin:$PATH"
ENV ABI_ENV=amplicon

WORKDIR /data
ENTRYPOINT ["abi"]
CMD ["list-types"]
