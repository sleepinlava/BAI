  "tools": [
    {
      "description": "Trim and quality-control paired-end RNA-seq reads.",
      "failure_handling": {
        "missing_input": {
          "hint": "Check sample sheet read1/read2 paths."
        },
        "nonzero_exit": {
          "hint": "Read provenance/step_logs/{step_id}.stderr.log."
        },
        "tool_not_found": {
          "hint": "Install fastp in the abi-qc environment."
        }
      },
      "id": "fastp",
      "name": "fastp",
      "outputs": {
        "clean_read1": {
          "format": "fastq.gz",
          "type": "file"
        },
        "clean_read2": {
          "format": "fastq.gz",
          "type": "file"
        },
        "html_report": {
          "format": "html",
          "type": "file"
        },
        "json_report": {
          "format": "json",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        }
      },
      "parameters": {
        "read1": {
          "formats": [
            "fastq",
            "fastq.gz"
          ],
          "required": true,
          "type": "file"
        },
        "read2": {
          "formats": [
            "fastq",
            "fastq.gz"
          ],
          "required": true,
          "type": "file"
        },
        "sample_id": {
          "required": true,
          "type": "string"
        },
        "threads": {
          "default": 4,
          "minimum": 1,
          "type": "integer"
        }
      },
      "resources": {
        "cpu": 4,
        "memory": "4GB",
        "walltime": "01:00:00"
      }
    },
    {
      "description": "Align RNA-seq reads to a STAR genome index.",
      "failure_handling": {
        "missing_resource": {
          "hint": "Configure resources.genome_index to a prepared STAR index."
        },
        "nonzero_exit": {
          "hint": "Inspect the STAR stderr log under provenance/step_logs."
        },
        "tool_not_found": {
          "hint": "Install STAR in the abi-stats environment."
        }
      },
      "id": "star",
      "name": "STAR",
      "outputs": {
        "bam": {
          "format": "bam",
          "type": "file"
        }
      },
      "parameters": {
        "genome_index": {
          "required": true,
          "type": "directory"
        },
        "output_prefix": {
          "required": true,
          "type": "string"
        },
        "read1": {
          "required": true,
          "type": "file"
        },
        "read2": {
          "required": true,
          "type": "file"
        },
        "threads": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "resources": {
        "cpu": 8,
        "memory": "32GB",
        "walltime": "04:00:00"
      }
    },
    {
      "description": "Count reads overlapping gene annotations from an aligned BAM file.",
      "failure_handling": {
        "missing_input": {
          "hint": "Check that the alignment step produced the BAM path in the plan."
        },
        "missing_resource": {
          "hint": "Configure resources.annotation_gtf to a valid GTF annotation."
        },
        "parse_failed": {
          "hint": "Check the featureCounts output format before normalizing gene_expression.tsv."
        },
        "tool_not_found": {
          "hint": "Install featureCounts in the abi-stats environment."
        }
      },
      "id": "featurecounts",
      "name": "featureCounts",
      "outputs": {
        "counts": {
          "format": "txt",
          "type": "file"
        }
      },
      "parameters": {
        "annotation_gtf": {
          "format": "gtf",
          "required": true,
          "type": "file"
        },
        "bam": {
          "format": "bam",
          "required": true,
          "type": "file"
        },
        "threads": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "resources": {
        "cpu": 4,
        "memory": "8GB",
        "walltime": "02:00:00"
      }
    },
    {
      "description": "Merge per-sample featureCounts outputs into a unified gene-level count matrix and sample metadata file for DESeq2.",
      "failure_handling": {
        "execution_error": {
          "hint": "Check that featureCounts output files have expected format (Geneid column + count column)."
        },
        "missing_input": {
          "hint": "Verify that all upstream featureCounts steps completed successfully and *.featureCounts.txt files exist."
        },
        "tool_not_found": {
          "hint": "Python 3 must be available in the rnaseq conda environment."
        }
      },
      "id": "build_count_matrix",
      "name": "Build Count Matrix",
      "outputs": {
        "count_matrix": {
          "description": "Gene-level count matrix (genes \u00d7 samples)",
          "format": "tsv",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        },
        "sample_metadata": {
          "description": "Sample metadata for DESeq2",
          "format": "tsv",
          "type": "file"
        }
      },
      "parameters": {
        "count_matrix_script": {
          "description": "Path to build_count_matrix.py",
          "formats": [
            "py"
          ],
          "required": true,
          "type": "file"
        },
        "expression_dir": {
          "description": "Root directory containing per-sample featureCounts output subdirectories",
          "required": true,
          "type": "directory"
        },
        "sample_sheet": {
          "description": "Sample sheet with sample_id, group, condition columns",
          "formats": [
            "tsv"
          ],
          "required": true,
          "type": "file"
        }
      },
      "resources": {
        "cpu": 1,
        "memory": "1GB",
        "walltime": "00:15:00"
      }
    },
    {
      "description": "Perform differential gene expression analysis using DESeq2 median-of-ratios normalisation and Wald test.",
      "failure_handling": {
        "execution_error": {
          "hint": "DESeq2 execution failed. Check that sample_metadata groups match count_matrix columns and there are at least 2 replicates per group."
        },
        "missing_input": {
          "hint": "One or both of count_matrix or sample_metadata files are missing. Verify featureCounts completed successfully."
        },
        "tool_not_found": {
          "hint": "Rscript or DESeq2 package not available. Ensure R is installed and DESeq2 is installed (BiocManager::install('DESeq2'))."
        }
      },
      "id": "deseq2",
      "name": "DESeq2",
      "outputs": {
        "de_results": {
          "format": "tsv",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        }
      },
      "parameters": {
        "alpha": {
          "default": 0.05,
          "type": "number"
        },
        "comparison": {
          "required": true,
          "type": "string"
        },
        "count_matrix": {
          "formats": [
            "tsv"
          ],
          "required": true,
          "type": "file"
        },
        "deseq2_script": {
          "formats": [
            "R"
          ],
          "required": true,
          "type": "file"
        },
        "design": {
          "default": "~ condition",
          "description": "DESeq2 design formula evaluated against sample-metadata columns. It must include condition; paired experiments may use \"~ donor + condition\".",
          "type": "string"
        },
        "sample_metadata": {
          "formats": [
            "tsv"
          ],
          "required": true,
          "type": "file"
        }
      },
      "resources": {
        "cpu": 1,
        "memory": "8GB",
        "walltime": "01:00:00"
      }
    },
    {
      "description": "Add GTF gene symbols and run offline GO/Reactome ORA and preranked GSEA.",
      "failure_handling": {
        "execution_error": {
          "hint": "Check gene identifiers, GTF gene_name attributes, and enrichment resources."
        },
        "missing_input": {
          "hint": "Configure GRCh37.75 GTF, GO OBO/GAF, and Reactome GMT local paths."
        },
        "tool_not_found": {
          "hint": "Install the locked rnaseq environment containing gseapy 1.3.0."
        }
      },
      "id": "rnaseq_enrichment",
      "name": "Offline RNA-seq Enrichment",
      "outputs": {
        "annotated_de": {
          "format": "tsv",
          "type": "file"
        },
        "enrichment_manifest": {
          "format": "json",
          "type": "file"
        },
        "go_gsea": {
          "format": "tsv",
          "type": "file"
        },
        "go_gsea_plot": {
          "format": "tsv",
          "type": "file"
        },
        "go_ora": {
          "format": "tsv",
          "type": "file"
        },
        "go_ora_plot": {
          "format": "tsv",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        },
        "reactome_gsea": {
          "format": "tsv",
          "type": "file"
        },
        "reactome_gsea_plot": {
          "format": "tsv",
          "type": "file"
        },
        "reactome_ora": {
          "format": "tsv",
          "type": "file"
        },
        "reactome_ora_plot": {
          "format": "tsv",
          "type": "file"
        }
      },
      "parameters": {
        "annotation_gtf": {
          "formats": [
            "gtf"
          ],
          "required": true,
          "type": "file"
        },
        "de_results": {
          "formats": [
            "tsv"
          ],
          "required": true,
          "type": "file"
        },
        "enrichment_script": {
          "formats": [
            "py"
          ],
          "required": true,
          "type": "file"
        },
        "go_gaf": {
          "formats": [
            "gaf.gz"
          ],
          "required": true,
