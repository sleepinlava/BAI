        }
      },
      "resources": {
        "cpu": 4,
        "memory": "8GB",
        "walltime": "02:00:00"
      }
    },
    {
      "description": "Identify antimicrobial resistance genes, stress response genes, and virulence factors in bacterial protein sequences.",
      "failure_handling": {
        "missing_input": {
          "hint": "Prokka protein FASTA or GFF not found. Verify Prokka completed successfully."
        },
        "tool_not_found": {
          "hint": "AMRFinderPlus not found. Install: conda install -c bioconda ncbi-amrfinderplus"
        }
      },
      "id": "amrfinderplus",
      "name": "AMRFinderPlus",
      "outputs": {
        "amr_tsv": {
