  "platforms": [
    "illumina"
  ],
  "plugin": {
    "analysis_type": "wgs_bacteria",
    "description": "Clinical/food/environmental bacterial isolate analysis: QC (fastp) \u2192 assembly (SPAdes) \u2192 annotation (Prokka) \u2192 MLST \u2192 AMR profiling.",
    "display_name": "WGS Bacterial Genome Analysis"
  },
  "schema_version": "abi.control-validation.contract-snapshot.v1",
  "stages": [
    {
      "category": "qc",
      "id": "qc_fastp",
      "optional": false,
      "tool_id": "fastp"
    },
    {
      "category": "assembly",
      "id": "assembly_spades",
      "optional": false,
      "tool_id": "spades"
    },
    {
      "category": "annotation",
      "id": "annotation_prokka",
      "optional": false,
      "tool_id": "prokka"
    },
    {
      "category": "typing",
      "id": "mlst",
      "optional": false,
      "tool_id": "mlst"
    },
    {
      "category": "amr",
      "id": "amr",
      "optional": false,
      "tool_id": "amrfinderplus"
    }
  ],
  "standard_tables": {
