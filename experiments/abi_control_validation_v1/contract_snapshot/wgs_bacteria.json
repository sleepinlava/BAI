  "error_categories": [
    "artifact_missing",
    "contract_violation",
    "duplicate_sample_id",
    "empty_result",
    "incomplete_pairs",
    "internal_error",
    "invalid_config",
    "invalid_platform",
    "invalid_sample_sheet",
    "missing_database",
