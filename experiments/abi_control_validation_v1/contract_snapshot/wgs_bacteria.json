  "tools": [
    {
      "description": "Trim and quality-control paired-end RNA-seq reads.",
      "failure_handling": {
        "missing_input": {
          "hint": "Check sample sheet read1/read2 paths."
        },
        "nonzero_exit": {
          "hint": "Read provenance/step_logs/{step_id}.stderr.log."
        },
        "tool_not_found": {
          "hint": "Install fastp in the abi-qc environment."
        }
      },
      "id": "fastp",
      "name": "fastp",
      "outputs": {
        "clean_read1": {
          "format": "fastq.gz",
          "type": "file"
        },
        "clean_read2": {
          "format": "fastq.gz",
          "type": "file"
        },
        "html_report": {
          "format": "html",
          "type": "file"
        },
        "json_report": {
          "format": "json",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        }
      },
      "parameters": {
        "read1": {
          "formats": [
            "fastq",
            "fastq.gz"
          ],
          "required": true,
          "type": "file"
        },
        "read2": {
          "formats": [
            "fastq",
            "fastq.gz"
          ],
          "required": true,
          "type": "file"
        },
        "sample_id": {
          "required": true,
          "type": "string"
        },
        "threads": {
          "default": 4,
          "minimum": 1,
          "type": "integer"
        }
      },
      "resources": {
        "cpu": 4,
        "memory": "4GB",
        "walltime": "01:00:00"
      }
    },
    {
      "description": "De novo genome assembly from paired-end Illumina reads using SPAdes in isolate mode.",
      "failure_handling": {
        "missing_input": {
          "hint": "Cleaned FASTQ files not found. Verify fastp completed successfully."
        },
        "tool_not_found": {
          "hint": "SPAdes not found. Install: conda install -c bioconda spades"
        }
      },
      "id": "spades",
      "name": "SPAdes",
      "outputs": {
        "contigs_fasta": {
          "format": "fasta",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        },
        "scaffolds_fasta": {
          "format": "fasta",
          "type": "file"
        }
      },
      "parameters": {
        "clean_read1": {
          "formats": [
            "fastq",
            "fastq.gz"
          ],
          "required": true,
          "type": "file"
        },
        "clean_read2": {
          "formats": [
            "fastq",
            "fastq.gz"
          ],
          "required": true,
          "type": "file"
        },
        "memory_gb": {
          "default": 80,
          "minimum": 1,
          "type": "integer"
        },
        "threads": {
          "default": 4,
          "minimum": 1,
          "type": "integer"
        }
      },
      "resources": {
        "cpu": 16,
        "memory": "64GB",
        "walltime": "08:00:00"
      }
    },
    {
      "description": "Rapid prokaryotic genome annotation producing GFF, GenBank, and protein FASTA files.",
      "failure_handling": {
        "missing_input": {
          "hint": "Assembly FASTA not found. Verify SPAdes completed successfully."
        },
        "tool_not_found": {
          "hint": "Prokka not found. Install: conda install -c bioconda prokka"
        }
      },
      "id": "prokka",
      "name": "Prokka",
      "outputs": {
        "faa": {
          "format": "fasta",
          "type": "file"
        },
        "gbk": {
          "format": "gbk",
          "type": "file"
        },
        "gff": {
          "format": "gff",
          "type": "file"
        },
        "output_dir": {
          "type": "directory"
        }
      },
      "parameters": {
        "assembly_fasta": {
          "formats": [
            "fasta"
          ],
          "required": true,
          "type": "file"
        },
        "genus": {
          "required": false,
          "type": "string"
        },
        "sample_id": {
          "required": true,
          "type": "string"
        },
        "species": {
          "required": false,
          "type": "string"
        },
        "threads": {
          "default": 4,
          "minimum": 1,
          "type": "integer"
        }
      },
      "resources": {
        "cpu": 8,
        "memory": "16GB",
        "walltime": "04:00:00"
      }
    },
    {
      "description": "Multi-locus sequence typing (MLST) for bacterial isolates using the PubMLST scheme database.",
      "failure_handling": {
